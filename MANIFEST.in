include README.md RESULTS.md LICENSE pyproject.toml
recursive-include src/faultline *.py
recursive-include tests/faultline *.py
include scripts/validate_faultline.py scripts/check_release.py
include scripts/validate_upgrades.py
include scripts/validate_native.py
include scripts/validate_aot.py
include examples/capture_mlp.py
include examples/models.py
include examples/native_models.py
include examples/relu_sensitivity.py
include docs/architecture.md docs/cli.md docs/validation.json
include docs/diagnostics.md
include docs/numerics.md
include docs/sweeps.md
include docs/gpt2-accuracy.csv
include docs/accuracy-shift-010.csv docs/accuracy-shift-011.csv docs/bisection-011.csv
include docs/bisect.md docs/v011-policy.json
global-exclude __pycache__ *.py[cod] AGENTS.md CLAUDE.md
exclude tests/test_*.py
prune reports
prune frontend
prune _private
prune src/molsys
prune infra
prune native
prune research
prune experiments
